# ==========================================================
# KaamSetu Backend - Environment Variables Example
# Copy this file to ".env" and fill real values.
# NEVER commit the real ".env" file.
# ==========================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/kaamsetu

# JWT secret (use a long random string in production)
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# CORS: the API currently reflects ANY origin (needed for all Vercel/preview
# domains + credentials: true). This variable is kept for future allowlisting
# but is not enforced right now.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Bcrypt salt rounds
BCRYPT_SALT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Super Admin bootstrap (used only by scripts/bootstrapSuperAdmin.js)
BOOTSTRAP_SUPERADMIN_NAME=Super Admin
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@kaamsetu.local
BOOTSTRAP_SUPERADMIN_PHONE=9000000000
# Leave password empty to be prompted on the console (recommended)
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Development-only admin seed (used only by scripts/seedDevAdmins.js, never in production).
# Prefer passing these inline on the command line instead of saving them in .env.
# DEV_SUPERADMIN_NAME=Dev Super Admin
# DEV_SUPERADMIN_EMAIL=
# DEV_SUPERADMIN_PHONE=
# DEV_SUPERADMIN_PASSWORD=
# DEV_NAKA_ADMIN_NAME=Dev Naka Admin
# DEV_NAKA_ADMIN_EMAIL=
# DEV_NAKA_ADMIN_PHONE=
# DEV_NAKA_ADMIN_PASSWORD=
# DEV_NAKA_NAME=Dev Naka
# DEV_NAKA_CITY=Surat
# DEV_NAKA_AREA=Udhna
